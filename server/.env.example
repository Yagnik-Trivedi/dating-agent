JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Copy exact IDs from `node scripts/smoke.js`
MODEL_FAST=
MODEL_MID=
MODEL_SMART=
MODEL_EMBED=
