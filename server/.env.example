PORT=5000
NODE_ENV=development
# Comma-separated list allowed
CLIENT_URL=http://localhost:5173
# Optional: regex for Vercel preview URLs that may call the API (default: this project's team-scoped previews)
# CLIENT_URL_PATTERN=
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dating_agent?retryWrites=true&w=majority
# Local only, if Node can't resolve mongodb+srv:// on your network (querySrv ECONNREFUSED): public DNS for lookups
# DNS_SERVERS=8.8.8.8,1.1.1.1
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Header x-admin-token for GET /api/admin/usage
ADMIN_TOKEN=replace-with-a-random-string
# Shared password for the demo seed personas (npm run seed). Pick your own; never commit it.
SEED_PASSWORD=
# Judge demo accounts (seed.js --judges); share it only in Devpost's private testing instructions
JUDGE_PASSWORD=
# Tavily date ideas: 1,000 credits shared by everything. All-time searches per database (cached ideas are free), and per user per day.
TAVILY_MAX_SEARCHES=30
TAVILY_SEARCHES_PER_USER_DAY=3

# --- LLM provider -------------------------------------------------------------
# Final (judging): Nebius Token Factory. Temporary (dev): NVIDIA build.nvidia.com.
# Switching is .env-only; see plan/14-switch-to-nebius.md.
#   Nebius: LLM_PROVIDER=nebius  NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
#   NVIDIA: LLM_PROVIDER=nvidia  NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1   (key starts with nvapi-)
LLM_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Exact IDs from `npm run smoke`. NVIDIA IDs (Oct 2026):
#   fast  = nvidia/nemotron-3.5-lightning-30b-a3b   (~1 s/call with reasoning off; Nemotron 3 Nano Omni nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
#           works but swings 4-40 s and 503s when busy; nvidia/nemotron-nano-3-30b-a3b is listed but 404s on free accounts)
#   mid   = Nemotron 3 Super  nvidia/nemotron-3-super-120b-a12b
#   smart = Nemotron 3 Ultra  nvidia/nemotron-3-ultra-550b-a55b   (final verdict only)
#   embed = nvidia/nemotron-3-embed-1b   (2048-dim; takes input_type=passage|query, sent automatically)
MODEL_FAST=
MODEL_MID=
MODEL_SMART=
MODEL_EMBED=
TAVILY_API_KEY=
# Nemotron reasoning per tier (sent as chat_template_kwargs.enable_thinking; dropped automatically if a provider
# rejects it). Off for fast: chat turns take ~1 s instead of 10-40 s and can't run out of tokens mid-thought.
LLM_REASONING_FAST=false
LLM_REASONING_MID=true
LLM_REASONING_SMART=true
# Optional: move tasks between tiers without code, e.g. agent-stance-check=fast,icebreakers=fast (services/llm/tasks.js)
# LLM_TASK_TIERS=

# --- Rate limits + daily budgets ----------------------------------------------
# NVIDIA free tier allows ~40 requests/min in total
LLM_MAX_RPM=35
LLM_DAILY_CALLS_PER_USER=300
LLM_DAILY_TOKENS_GLOBAL=3000000
LLM_SMART_DAILY_CALLS=60

# --- Hard spending protection ---------------------------------------------------
# false = kill switch: every LLM call fails immediately, UI shows "Agent paused"
LLM_ENABLED=true
# All-time USD cap across every call; once reached ALL LLM calls are blocked
LLM_HARD_CAP_USD=35
# USD per 1M tokens as "input,output" for the model in each tier. 0,0 on NVIDIA's free tier.
LLM_PRICE_FAST=0,0
LLM_PRICE_MID=0,0
LLM_PRICE_SMART=0,0
LLM_PRICE_EMBED=0,0
LLM_PRICE_VISION=0,0
# Photo moderation (plan 30 S3): one Nemotron vision call per photo, decided in code.
MODEL_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b
# Plan 30 photos: Cloudinary free plan (signed direct uploads, no SDK). Leave all three empty for the local stub
# (files saved in server/uploads, local dev only). Each photo gets one MODEL_VISION moderation call.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Agent conversation (plan 08) -----------------------------------------------
# Wait this long after the last incoming message, so a burst of 2-3 messages gets one reply
AGENT_DEBOUNCE_MS=4000
# Human-like pacing: min + 350 ms per word + 0-2 s jitter, capped at max. Typing indicator shows meanwhile.
AGENT_MIN_DELAY_MS=1500
AGENT_MAX_DELAY_MS=20000
# Stop if the other side hasn't replied for this long
AGENT_STALE_HOURS=24
# true = demo pacing (0.3-2 s per reply)
# info (production default): errors + one line per LLM call, no message contents; debug (local default): + diagnostics with contents
# LOG_LEVEL=debug
# Agent typing delays: fast = 0.8–3 s, overlapping the model work (default); normal = human-like (350 ms/word)
# AGENT_PACING=fast
# Agent messages per match per minute, both agents together (the loop guard)
# AGENT_MAX_REPLIES_PER_MINUTE=12
# New agent conversations per non-seed user per UTC day; more matches start the next day (credit guard for judging)
JUDGE_LIVE_CHATS_PER_DAY=2
# Eval ablation only (plan 11 B4): off = plain agents with no act plan, stance check, exemplars or interest meter
RULES=on
# Plan 31: human = simple, mood-matched chat with at most one plain matching question (default); sn = plan 30 SN (fallback)
# CONVO_MODE=human
# ORIGIN_SECRET=  (UI polish B8: same value as the Vercel project's ORIGIN_SECRET; 24+ random chars)
# FLOW=natural  (plan 34; plan33 = the plan-33 conversation exactly)
# Plan 33: full = sessions over hours/days, high bar for a match; demo = 3 short sessions a minute apart; short = one
# 14-message chat with the old judge rule. Unset = demo for matches with a seed/judge account, full for everyone else.
# CHAT_DEPTH=
# false = this process only enqueues jobs (the web process runs the worker)
JOB_WORKER=true
# Render only: self-ping RENDER_EXTERNAL_URL/health every N minutes (Render sets RENDER_EXTERNAL_URL itself)
KEEPALIVE_SELF_PING=false
KEEPALIVE_INTERVAL_MIN=10

# Owner, 2026-10-22: photos optional while testing conversations (no Cloudinary on Render yet). true = photos required again.
PHOTOS_REQUIRED=false
