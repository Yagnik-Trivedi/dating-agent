{
  "info": {
    "name": "dating-agent API",
    "description": "Plan 04 API contract. Run \"Signup\" or \"Login\" first: it stores {{token}}. Set {{matchId}}, {{userId}}, {{factId}}, {{inboxId}} as needed. Socket.IO events are documented in plan/04-backend-core.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "matchId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "factId",
      "value": ""
    },
    {
      "key": "inboxId",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Health (deep)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/deep",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "deep"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.token) pm.collectionVariables.set(\"token\", b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Alice\",\n  \"consentAgent\": true\n}"
            }
          }
        },
        {
          "name": "Signup without consent (400)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nope@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Nope\",\n  \"consentAgent\": false\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.token) pm.collectionVariables.set(\"token\", b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          }
        },
        {
          "name": "Update settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me",
                "settings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentMode\": \"shadow\"\n}"
            }
          }
        },
        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profile"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"age\": 27,\n  \"city\": \"Pune\",\n  \"gender\": \"woman\",\n  \"interestedIn\": [\n    \"man\"\n  ],\n  \"photos\": [\n    \"https://api.dicebear.com/9.x/notionists/svg?seed=alice\"\n  ],\n  \"bio\": \"Weekend trekker, weekday product designer.\",\n  \"prompts\": [\n    {\n      \"q\": \"A perfect Sunday\",\n      \"a\": \"Sunrise trek, then a long breakfast.\"\n    }\n  ],\n  \"tags\": {\n    \"interests\": [\n      \"trekking\",\n      \"design\"\n    ],\n    \"lifestyle\": {\n      \"smoking\": \"no\",\n      \"drinking\": \"socially\",\n      \"workout\": \"often\",\n      \"diet\": \"vegetarian\"\n    },\n    \"wantsKids\": \"open\",\n    \"relationshipGoal\": \"long-term\",\n    \"religionImportance\": \"low\"\n  },\n  \"dealbreakers\": [\n    \"smoking\"\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Submit answers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {\n    \"weekend\": \"Trekking with friends\"\n  }\n}"
            }
          }
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Knowledge graph",
      "item": [
        {
          "name": "My graph",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/kg/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "kg",
                "me"
              ]
            }
          }
        },
        {
          "name": "Set fact disclosure",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/kg/facts/{{factId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "kg",
                "facts",
                "{{factId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disclosure\": \"if_asked\"\n}"
            }
          }
        },
        {
          "name": "Delete fact",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/kg/facts/{{factId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "kg",
                "facts",
                "{{factId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Discover & likes",
      "item": [
        {
          "name": "Discover",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/discover?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "discover"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Like",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/likes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "likes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toUserId\": \"{{userId}}\",\n  \"liked\": true\n}"
            }
          }
        },
        {
          "name": "Pass",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/likes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "likes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toUserId\": \"{{userId}}\",\n  \"liked\": false\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "List matches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches"
              ]
            }
          }
        },
        {
          "name": "Match detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{matchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{matchId}}"
              ]
            }
          }
        },
        {
          "name": "Messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{matchId}}/messages?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{matchId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Send message",
          "request": {
            "method": "POST",
            "header": [
