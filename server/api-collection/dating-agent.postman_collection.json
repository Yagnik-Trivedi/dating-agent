                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{matchId}}",
                "kg"
              ]
            }
          }
        },
        {
          "name": "Date ideas (plan 09)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{matchId}}/date-ideas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{matchId}}",
                "date-ideas"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Inbox",
      "item": [
        {
          "name": "Inbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inbox?status=open",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inbox"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                }
              ]
            }
          }
        },
        {
          "name": "Answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inbox/{{inboxId}}/answer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inbox",
                "{{inboxId}}",
                "answer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answer\": \"Yes, I have a dog named Momo.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Usage today",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "x-admin-token",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/usage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "usage"
              ]
            }
          }
        }
      ]
    }
  ]
}
